{
  "expo": {
    "name": "SehatSaathi",
    "slug": "sehatsaathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f4f9ff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.chaitanyajhindal.sehatsaathi"
    },
    "plugins": [
      "expo-document-picker",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f219e8b9-d175-41bd-8c53-9b6a998aad10"
      }
    }
  }
}
