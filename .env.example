# Speech-to-Text & Clinical LLM
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_FALLBACK_API_KEY=your_sarvam_fallback_api_key
SARVAM_NUM_SPEAKERS=20
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=sehatsaathi

# Auth & CORS
JWT_SECRET=replace_with_long_random_secret
CORS_ORIGINS=http://localhost:8000,http://localhost:8081

# Built-in WhatsApp Web QR bridge (managed automatically by FastAPI)
WA_BRIDGE_PORT=2785
DEFAULT_PHONE_COUNTRY_CODE=91

# Optional public URL for PDF download links
PUBLIC_BASE_URL=

# Optional frontend override (for Expo mobile testing against LAN/tunnel IP)
EXPO_PUBLIC_API_URL=
